{
  "manifest_version": 3,
  "name": "CodeConClave AI - browser helper",
  "short_name": "CodeConClave",
  "version": "1.0.0",
  "description": "Lets CodeConClave AI open, read, click and type in your own Chrome - every action asks you first.",
  "key": "",
  "icons": {
    "128": "icon.png"
  },
  "action": {
    "default_title": "CodeConClave AI browser helper"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabs",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "externally_connectable": {
    "matches": [
      "https://codeconclave-ww5x.onrender.com/*",
      "http://localhost:3107/*"
    ]
  }
}
